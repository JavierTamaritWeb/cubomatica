{
  "name": "cubomatica",
  "version": "3.4.4",
  "private": true,
  "description": "Cubomatica — juego de matematicas para 2.º de Primaria (RD 157/2022)",
  "license": "MIT",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "limpiar": "gulp limpiar",
    "build": "gulp build",
    "dev": "gulp dev",
    "auditar": "node pruebas/auditar.mjs",
    "dependencias": "node herramientas/comprobar-dependencias.mjs",
    "dependencias:limpiar": "node herramientas/limpiar-dependencias.mjs",
    "postinstall": "npm run dependencias:limpiar",
    "entregar": "npm run dependencias && npm run estilo && npm run build && npm run auditar",
    "cruzar": "node herramientas/cruzar-clases.mjs",
    "estilo": "npm run estilo:js && npm run estilo:scss",
    "estilo:js": "eslint . --max-warnings 0",
    "estilo:scss": "stylelint \"src/scss/**/*.scss\"",
    "autoprueba": "node pruebas/auditar.mjs --autoprueba"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.21",
    "cssnano": "^7.1.1",
    "eslint": "^10.9.0",
    "gulp": "^5.0.1",
    "gulp-cli": "^3.1.0",
    "gulp-concat": "^2.6.1",
    "gulp-html-minifier-terser": "^7.1.0",
    "gulp-postcss": "^10.0.0",
    "gulp-rename": "^2.1.0",
    "gulp-replace": "^1.1.4",
    "gulp-sass": "^6.0.1",
    "gulp-terser": "^2.1.0",
    "html-minifier-terser": "^7.2.0",
    "postcss": "^8.5.6",
    "postcss-scss": "^4.0.9",
    "sass-embedded": "^1.103.1",
    "stylelint": "^17.14.1",
    "stylelint-config-standard-scss": "^17.0.0",
    "terser": "^5.44.0"
  }
}
